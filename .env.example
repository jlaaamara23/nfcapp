# Backend / database (development only — never commit real secrets)
POSTGRES_DB=nfc_attendance
POSTGRES_USER=nfc_attendance
POSTGRES_PASSWORD=nfc_dev_password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nfc_attendance
SPRING_DATASOURCE_USERNAME=nfc_attendance
SPRING_DATASOURCE_PASSWORD=nfc_dev_password

# JWT signing key — use a long random value in production
APP_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
APP_JWT_EXPIRATION_MS=86400000

# CORS for Admin SPA
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin frontend
VITE_API_BASE_URL=http://localhost:8080
