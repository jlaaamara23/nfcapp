<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/white">

    <TextView
        android:id="@+id/greetingText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ink"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/todayStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/teal_700"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/hoursText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/ink"
        android:textSize="16sp" />

    <Button
        android:id="@+id/clockInButton"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="@color/teal_700"
        android:text="@string/clock_in"
        android:textSize="22sp" />

    <Button
        android:id="@+id/clockOutButton"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/amber_600"
        android:text="@string/clock_out"
        android:textSize="22sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/historyButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/teal_900"
            android:text="@string/history" />

        <Button
            android:id="@+id/profileButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/teal_900"
            android:text="@string/profile" />
    </LinearLayout>

    <Button
        android:id="@+id/logoutButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/danger"
        android:text="@string/logout" />
</LinearLayout>
